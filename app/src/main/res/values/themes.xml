<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Svitlograf" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Segmented list cards (Android 16+ settings look): big outer corners, small inner ones, 2dp gaps -->
    <style name="Seg" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="cardPreventCornerOverlap">false</item>
        <item name="contentPaddingLeft">20dp</item>
        <item name="contentPaddingRight">16dp</item>
        <item name="contentPaddingTop">14dp</item>
        <item name="contentPaddingBottom">14dp</item>
        <item name="shapeAppearanceOverlay">@style/Shape.SegSingle</item>
    </style>
    <style name="Seg.Top"><item name="shapeAppearanceOverlay">@style/Shape.SegTop</item></style>
    <style name="Seg.Mid"><item name="shapeAppearanceOverlay">@style/Shape.SegMid</item></style>
    <style name="Seg.Bottom"><item name="shapeAppearanceOverlay">@style/Shape.SegBottom</item></style>

    <style name="Shape.SegSingle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
    <style name="Shape.SegTop" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">6dp</item>
        <item name="cornerSizeBottomRight">6dp</item>
    </style>
    <style name="Shape.SegMid" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">6dp</item>
    </style>
    <style name="Shape.SegBottom" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">6dp</item>
        <item name="cornerSizeTopRight">6dp</item>
        <item name="cornerSizeBottomLeft">28dp</item>
        <item name="cornerSizeBottomRight">28dp</item>
    </style>

    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
    <style name="RowTitle">
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="RowSub">
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
